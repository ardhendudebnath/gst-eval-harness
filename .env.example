# Copy to .env and fill in. Only needed from week 4 (model runs) onward;
# the dataset tooling needs no keys.
#
# .env is git-ignored. Never commit real keys.

# Frontier / mid / small tiers: opus-5, sonnet-5, haiku-4-5. Optional — the
# open-weight rows run without it. A zero-arg Anthropic client also resolves
# ANTHROPIC_AUTH_TOKEN or an `ant auth login` profile, so an unset variable
# here does not necessarily mean there are no credentials.
ANTHROPIC_API_KEY=

# Placeholders. No model in the registry uses either of these today, so
# filling them in changes nothing — they are here for a GPT or Gemini row
# that does not exist yet. Listing a key the harness never reads is how the
# .env file itself went unread for three weeks.
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Open-weight tier, served through NVIDIA's API catalog so no GPU is needed to
# benchmark it. The default is llama-3.3-nemotron-super-49b-v1.5, chosen
# because it has a published NIM container — self-hostability you can
# demonstrate rather than infer.
NVIDIA_API_KEY=
# Optional: override the model id without editing the registry.
NVIDIA_MODEL=

# Self-hosted NIM. No key needed — it is your own container. Only set the base
# URL if the GPU is not on this machine.
#   python -m harness.run --model open-weight-local
NIM_BASE_URL=http://localhost:8000
NIM_MODEL=

# Alternative route to open-weight models.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
