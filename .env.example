# Copy to .env and fill in. Only needed from week 4 (model runs) onward;
# the dataset tooling needs no keys.
#
# .env is git-ignored. Never commit real keys.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=

# Open-weight tier, served through NVIDIA's API catalog so no GPU is needed
# to benchmark it. The default model is nemotron-3.5-lightning-30b-a3b —
# 30B total / 3B active, which you could actually self-host, and that is what
# makes it the bridge to project 03.
NVIDIA_API_KEY=
# Optional: override the model id without editing the registry.
NVIDIA_MODEL=

# Alternative route to open-weight models.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
